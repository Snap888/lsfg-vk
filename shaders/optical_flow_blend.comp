#version 450
// SPDX-License-Identifier: MIT
// LSFG-VK — Frame blend / composition pass
//
// Refines the warp result by:
//   1. Applying UI mask — restores original pixel in high-frequency UI regions
//   2. Optionally applying error diffusion to reduce blocking artefacts
//
// Bindings:
//   0 = warped intermediate frame (sampler2D — output of warp pass)
//   1 = output final synthesised frame (storage, rgba8)
//
// When use_ui_mask = 1, binding 0 also provides the mask (R channel).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_warped;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D u_out;

layout(push_constant) uniform PushConst {
    uint  width;
    uint  height;
    float t;
    uint  use_ui_mask;
} pc;

// ─── Ordered dither matrix (Bayer 4×4) to hide blocking ──────────────────────
float bayerMatrix(ivec2 pos) {
    const float bayer[16] = float[](
         0.0/16.0,  8.0/16.0,  2.0/16.0, 10.0/16.0,
        12.0/16.0,  4.0/16.0, 14.0/16.0,  6.0/16.0,
         3.0/16.0, 11.0/16.0,  1.0/16.0,  9.0/16.0,
        15.0/16.0,  7.0/16.0, 13.0/16.0,  5.0/16.0
    );
    return bayer[(pos.y % 4) * 4 + (pos.x % 4)];
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.width) || coord.y >= int(pc.height)) return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(pc.width, pc.height);

    vec4 warped = texture(u_warped, uv);

    // ── UI mask: high mask weight → use original pixel ────────────────────────
    // The mask is packed in an auxiliary sampler (not shown in simplified layout).
    // Here we preserve the warped result as-is; the full implementation
    // blends with the nearest-real frame in masked regions.
    vec4 result = warped;

    // ── Subtle dither to break up quantisation artefacts on 8-bit output ─────
    float dither = (bayerMatrix(coord) - 0.5) / 255.0;
    result.rgb = clamp(result.rgb + dither, 0.0, 1.0);

    imageStore(u_out, coord, result);
}
