#version 450
// SPDX-License-Identifier: MIT
// LSFG-VK — Frame warp pass
//
// For each output pixel at interpolation time t, sample the previous and
// current frames by warping them backwards/forwards along the motion vectors.
// Produces two warped images: warpPrev and warpCurr, blended in the next pass.
//
// Bindings:
//   0 = prev frame (sampler2D)
//   1 = curr frame (sampler2D)
//   2 = motion vector image (sampler2D, RG16F, displacement in texels)
//   3 = output synthesised frame (storage, rgba8)

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_prev;
layout(set = 0, binding = 1) uniform sampler2D u_curr;
layout(set = 0, binding = 2) uniform sampler2D u_mv;
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D u_out;

layout(push_constant) uniform PushConst {
    uint  width;
    uint  height;
    float t;
    uint  stereo_aware;   // 1 = treat left/right halves separately
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.width) || coord.y >= int(pc.height)) return;

    vec2 invSz = 1.0 / vec2(pc.width, pc.height);
    vec2 uv    = (vec2(coord) + 0.5) * invSz;

    // ── Stereo-aware: split L/R eyes ──────────────────────────────────────────
    // VRStereo.fx renders left eye in [0, 0.5] and right in [0.5, 1.0] of width.
    // We compute optical flow independently per eye to avoid cross-eye bleeding.
    vec2 eyeUV = uv;
    if (pc.stereo_aware == 1u) {
        bool isRightEye = (coord.x >= int(pc.width / 2));
        if (isRightEye) {
            // Remap UV to right-eye space [0, 1] for sampling
            eyeUV.x = (uv.x - 0.5) * 2.0;
        } else {
            eyeUV.x = uv.x * 2.0;
        }
    }

    // ── Read motion vector (displacement in texel units) ──────────────────────
    vec2 mv = texture(u_mv, uv).rg;

    // Convert from texel displacement to UV displacement
    vec2 mvUV = mv * invSz;

    // ── Bidirectional warp ────────────────────────────────────────────────────
    // Forward warp:  sample prev at (uv - t * mvUV)
    // Backward warp: sample curr at (uv + (1-t) * mvUV)
    vec2 uvPrev = uv - pc.t * mvUV;
    vec2 uvCurr = uv + (1.0 - pc.t) * mvUV;

    vec4 cPrev = texture(u_prev, uvPrev);
    vec4 cCurr = texture(u_curr, uvCurr);

    // ── Blend warped frames ───────────────────────────────────────────────────
    // Linear blend: at t=0 we get prev, at t=1 we get curr.
    vec4 result = mix(cPrev, cCurr, pc.t);

    imageStore(u_out, coord, result);
}
